generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       BigInt    @id @default(autoincrement()) @map("user_id")
  password     String?   @db.VarChar(50)
  loginName    String    @map("login_name") @db.VarChar(50)
  groupId      Decimal?  @map("group_id") @db.Decimal(19, 2)
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @db.VarChar(255)
  telephone    String?   @db.VarChar(15)
  birthday     DateTime? @db.Date
  langId       String?   @map("lang_id") @db.VarChar(2)
  mainAddress  String?   @map("main_address") @db.VarChar(2048)
  facebookId   String?   @map("facebook_id") @db.VarChar(512)
  googleId     String?   @map("google_id") @db.VarChar(512)
  twitterId    String?   @map("twitter_id") @db.VarChar(512)
  cmtnd        Int?
  cccd         Int?
  mobile       Int?
  addUser      BigInt?   @map("add_user")
  updUser      BigInt?   @map("upd_user")
  addTime      DateTime? @map("add_time") @db.Timestamp(6)
  updTime      DateTime? @map("upd_time") @db.Timestamp(6)
  avata        Bytes?
  sex          Int?
  occupation   String?   @db.VarChar(512)
  avataUrl     String?   @map("avata_url") @db.VarChar(512)
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  cover        String?   @db.VarChar(512)
  activated    Int?
  displayOrder Int?      @map("display_order")
  refreshToken String?   @map("refresh_token") @db.VarChar
  appleId      String?   @map("apple_id") @db.VarChar(512)

  @@map("tbl_user")
}

model Role {
  roleId       BigInt    @id @default(autoincrement()) @map("role_id")
  roleName     String?   @map("role_name") @db.VarChar(512)
  description  String?   @db.VarChar(512)
  roleType     Int       @default(1) @map("role_type")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  displayOrder Int?      @map("display_order")

  @@map("role")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  @@id([userId, roleId])
  @@map("user_role")
}

model SessionInfo {
  sessionInfoId Decimal   @id @default(dbgenerated("nextval('session_info_id_seq'::regclass)")) @map("session_info_id") @db.Decimal(19, 2)
  userId        Decimal?  @map("user_id") @db.Decimal(19, 2)
  loginName     String?   @map("login_name") @db.VarChar
  refreshToken  String?   @map("refresh_token") @db.VarChar
  deleteFlg     Int?      @map("delete_flg")
  createdAt     DateTime? @map("created_at") @db.Timestamp(6)
  createdBy     String?   @map("created_by") @db.VarChar(255)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy     String?   @map("updated_by") @db.VarChar(255)
  displayOrder  Int?      @map("display_order")

  @@map("session_info")
}

model Function {
  functionId   BigInt    @id @default(autoincrement()) @map("function_id")
  moduleId     BigInt    @map("module_id")
  functionName String?   @map("function_name") @db.VarChar(512)
  description  String?   @db.VarChar(512)
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  displayOrder Int?      @map("display_order")

  @@map("function")
}

model RoleFunction {
  roleId     BigInt @map("role_id")
  functionId BigInt @map("function_id")
  permision  Int

  @@id([roleId, functionId])
  @@map("role_function")
}

model ProductRealm {
  productRealmId   BigInt    @id @default(autoincrement()) @map("product_realm_id")
  productRealmCode String?   @map("product_realm_code") @db.VarChar(512)
  productRealmName String?   @map("product_realm_name") @db.VarChar(512)
  displayOrder     Int?      @map("display_order")
  deleteFlg        Int?      @map("delete_flg")
  createdAt        DateTime? @map("created_at") @db.Timestamp(6)
  createdBy        String?   @map("created_by") @db.VarChar(255)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy        String?   @map("updated_by") @db.VarChar(255)
  isHidden         Boolean?  @map("is_hidden")
  avatar           BigInt?
  description      String?

  @@map("product_realm")
}

model ProductCategory {
  productCategoryId   BigInt    @id @default(autoincrement()) @map("product_category_id")
  productRealmId      BigInt?   @map("product_realm_id")
  productCategoryCode String?   @map("product_category_code") @db.VarChar(512)
  productCategoryName String?   @map("product_category_name") @db.VarChar(512)
  displayOrder        Int?      @map("display_order")
  deleteFlg           Int?      @map("delete_flg")
  createdAt           DateTime? @map("created_at") @db.Timestamp(6)
  createdBy           String?   @map("created_by") @db.VarChar(255)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy           String?   @map("updated_by") @db.VarChar(255)
  avatar              BigInt?

  @@map("product_category")
}

model Product {
  productId         BigInt    @id @default(autoincrement()) @map("product_id")
  productCategoryId BigInt?   @map("product_category_id")
  productCode       String?   @map("product_code") @db.VarChar(512)
  productName       String?   @map("product_name") @db.VarChar(512)
  price             Decimal?  @db.Decimal(31, 16)
  price2            Decimal?  @db.Decimal(31, 16)
  description1      String?
  description3      String?
  isSerial          Int?      @map("is_serial")
  displayOrder      Int?      @map("display_order")
  deleteFlg         Int?      @map("delete_flg")
  createdAt         DateTime? @map("created_at") @db.Timestamp(6)
  createdBy         String?   @map("created_by") @db.VarChar(255)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy         String?   @map("updated_by") @db.VarChar(255)
  description2      String?
  avatar            BigInt?
  description4      String?
  html1             String?
  html2             String?
  option1           String?
  option3           String?
  option2           String?
  introContent      String?   @map("intro_content")
  discountPercent   Int?      @map("discount_percent")
  isHiddenSerial    Boolean?  @map("is_hidden_serial")
  stopSelling       Boolean?  @default(false) @map("stop_selling")
  hot               Boolean?
  packingWeight     Decimal?  @map("packing_weight") @db.Decimal(32, 16)
  optionPrice       String?   @map("option_price")

  @@map("product")
}

model Room {
  roomId       String    @id @default(dbgenerated("uuid_generate_v4()")) @map("room_id") @db.Uuid
  roomName     String?   @map("room_name") @db.VarChar(512)
  roomType     Int?      @map("room_type")
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)

  @@map("room")
}

model RoomUser {
  roomId    String    @map("room_id") @db.Uuid
  userId    BigInt    @map("user_id")
  status    Int
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  @@id([roomId, userId])
  @@map("room_user")
}

model Message {
  messageId    BigInt    @id @default(autoincrement()) @map("message_id")
  roomId       String    @map("room_id") @db.Uuid
  userId       BigInt    @map("user_id")
  messageType  Int?      @map("message_type")
  messageValue String?   @map("message_value")
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)

  @@map("message")
}

model AccountBalance {
  userId       BigInt    @id @map("user_id")
  moneyAmount  Decimal?  @map("money_amount") @db.Decimal(32, 16)
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)

  @@map("account_balance")
}

model AccountHistory {
  accountHistoryId  BigInt    @id @default(autoincrement()) @map("account_history_id")
  userId            BigInt?   @map("user_id")
  accountActionType Int?      @map("account_action_type")
  moneyAmount       Decimal?  @map("money_amount") @db.Decimal(32, 16)
  note              String?
  displayOrder      Int?      @map("display_order")
  deleteFlg         Int?      @map("delete_flg")
  createdAt         DateTime? @map("created_at") @db.Timestamp(6)
  createdBy         String?   @map("created_by") @db.VarChar(255)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy         String?   @map("updated_by") @db.VarChar(255)
  data              String?

  @@map("account_history")
}

model Answer {
  answerId     BigInt    @id @default(autoincrement()) @map("answer_id")
  answerValue  String?   @map("answer_value")
  questionId   BigInt?   @map("question_id")
  parentId     BigInt?   @map("parent_id")
  likeNumber   Int?      @map("like_number")
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  images       String?

  @@map("answer")
}

model ProductGift {
  productGiftId    BigInt  @id @default(autoincrement()) @map("product_gift_id")
  productId        BigInt? @map("product_id")
  productGiftValue String? @map("product_gift_value") @db.VarChar(512)
  deleteFlg        Int?    @default(0) @map("delete_flg")
  createdAt        DateTime? @map("created_at") @db.Timestamp(6)
  createdBy        String?   @map("created_by") @db.VarChar(255)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy        String?   @map("updated_by") @db.VarChar(255)

  @@map("product_gift")
}

model AnswerLike {
  answerId BigInt @map("answer_id")
  userId   BigInt @map("user_id")

  @@id([answerId, userId])
  @@map("answer_like")
}

model Api {
  apiId        BigInt    @id @default(autoincrement()) @map("api_id")
  router       String?   @db.VarChar(512)
  methodId     Int       @map("method_id")
  actionTypeId Int       @map("action_type_id")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  displayOrder Int?      @map("display_order")

  @@map("api")
}

model ApiFunction {
  apiId      BigInt @map("api_id")
  functionId BigInt @map("function_id")

  @@id([apiId, functionId])
  @@map("api_function")
}

model AudioBook {
  audioBookId       BigInt    @id @default(autoincrement()) @map("audio_book_id")
  audioBookSeriesId BigInt    @map("audio_book_series_id")
  audioBookTitle    String?   @map("audio_book_title") @db.VarChar(512)
  description       String?
  image             String?
  displayOrder      Int?      @map("display_order")
  deleteFlg         Int?      @map("delete_flg")
  createdAt         DateTime? @map("created_at") @db.Timestamp(6)
  createdBy         String?   @map("created_by") @db.VarChar(255)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy         String?   @map("updated_by") @db.VarChar(255)

  @@map("audio_book")
}

model AudioBookSeries {
  audioBookSeriesId    BigInt                   @id @default(autoincrement()) @map("audio_book_series_id")
  audioBookSeriesTitle String?                  @map("audio_book_series_title") @db.VarChar(512)
  description          String?
  image                String?
