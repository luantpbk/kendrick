}

model GuidePage {
  guidePageId    BigInt    @id @default(autoincrement()) @map("guide_page_id")
  guidePageKey   String?   @map("guide_page_key") @db.VarChar(512)
  guidePageTitle String?   @map("guide_page_title") @db.VarChar(512)
  guidePageValue String?   @map("guide_page_value")
  description    String?
  displayOrder   Int?      @map("display_order")
