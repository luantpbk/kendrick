  fileName     String?   @map("file_name") @db.VarChar(255)
  fileTypeId   Int       @map("file_type_id")
  objectType   Int?      @map("object_type")
  objectId     BigInt?   @map("object_id")
  systemName   String?   @map("system_name") @db.VarChar(255)
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  displayOrder Int?      @map("display_order")

  @@map("file")
}

model FirebaseToken {
  firebaseTokenId Decimal   @id @default(dbgenerated("nextval('firebase_token_id_seq'::regclass)")) @map("firebase_token_id") @db.Decimal(19, 2)
  userName        String?   @map("user_name") @db.VarChar(255)
  deviceId        String?   @map("device_id") @db.VarChar(255)
  firebaseToken   String?   @map("firebase_token") @db.VarChar(255)
