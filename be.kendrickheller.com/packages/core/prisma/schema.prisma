  @@map("inventory")
}

model Module {
  moduleId     BigInt    @id @default(autoincrement()) @map("module_id")
  moduleName   String?   @map("module_name") @db.VarChar(512)
  description  String?   @db.VarChar(512)
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)
  displayOrder Int?      @map("display_order")

  @@map("module")
}

model News {
  newId        BigInt    @id(map: "new_pkey") @default(autoincrement()) @map("new_id")
  newTitle     String?   @map("new_title") @db.VarChar(512)
  newValue     String?   @map("new_value")
  description  String?
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
