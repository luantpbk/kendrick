  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)

  @@map("comment")
}

model CompanyInfo {
  companyInfoId    BigInt    @id @default(autoincrement()) @map("company_info_id")
  companyInfoKey   String?   @map("company_info_key") @db.VarChar(512)
  companyInfoTitle String?   @map("company_info_title") @db.VarChar(512)
  companyInfoValue String?   @map("company_info_value")
  href             String?
  displayOrder     Int?      @map("display_order")
  deleteFlg        Int?      @map("delete_flg")
  createdAt        DateTime? @map("created_at") @db.Timestamp(6)
  createdBy        String?   @map("created_by") @db.VarChar(255)
  updatedAt        DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy        String?   @map("updated_by") @db.VarChar(255)

  @@map("company_info")
}

model Country {
  countryId    BigInt    @id @default(autoincrement()) @map("country_id")
  countryName  String?   @map("country_name") @db.VarChar(512)
  displayOrder Int?      @map("display_order")
  deleteFlg    Int?      @map("delete_flg")
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  createdBy    String?   @map("created_by") @db.VarChar(255)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  updatedBy    String?   @map("updated_by") @db.VarChar(255)

  @@map("country")
}

